---
/*
  A one-click "subscribe in <reader>" chip.

  It used to hotlink each reader's own brand button straight from inoreader.com and
  feedly.com — the last two third-party requests on the homepage (ISSUES.md §4), and two
  rounded, gradient-y images sitting in the middle of a site whose whole identity is flat
  colour and hard angles. Rendering the readers as native chips kills the requests and puts
  the buttons in the site's own language.
*/
interface Props {
  /* The reader's subscribe endpoint; the feed URL is appended to it. */
  target: string;
  target_name: string;
}

const { target, target_name } = Astro.props;
const FEED_URL = "https://justgood.games/rss.xml";
---

<a
  href={`${target}${encodeURIComponent(FEED_URL)}`}
  target="_blank"
  rel="noopener noreferrer"
  class="jgg-press inline-flex w-full items-center justify-center border-[3px] border-foreground-500 bg-accent-300 px-4 py-2 font-heading text-lg uppercase tracking-wide focus-visible:outline-[3px] focus-visible:outline-offset-[3px] focus-visible:outline-secondary-600 md:w-auto md:text-xl"
>
  Subscribe in {target_name}
</a>
