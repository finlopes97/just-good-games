---
import Layout from "../layouts/Layout.astro";
import BlogPostCard from "../components/BlogPostCard.astro";
import NavLink from "../components/NavLink.astro";
import HeroPost from "../components/HeroPost.astro";
import RSSReaderLink from "@components/RSSReaderLink.astro";
import { getCollection } from "astro:content";
import { formatDate } from "../utils/dateFormatter";
import { getExcerpt } from "../utils/excerpt";
import RSS from "@components/RSS.astro";

const title = "Home";
const description =
  "Reviews and articles about lesser-known indie games — the kind with forty Steam reviews and one great idea.";

// Get all posts and sort them by publication date (most recent first)
const allPosts = await getCollection("posts");
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// The most recent post is the hero; the next 6 fill the "Latest Posts" grid below it.
const heroPost = sortedPosts[0];
const recentPosts = sortedPosts.slice(1, 7);
---

<style>
  h1 {
    -webkit-text-stroke-width: 2px;
    -webkit-text-stroke-color: black;
  }
</style>

<Layout title={title} description={description} pageType="website">
  <div>
    <h1 class="text-4xl text-center md:text-5xl font-heading text-primary-600">
      Just Good Games.
    </h1>
    <h2 class="text-3xl font-heading text-center mb-8">Latest Article</h2>
    {
      (heroPost && (
        <HeroPost
          title={heroPost.data.title}
          url={`/posts/${heroPost.id}/`}
          pubDate={formatDate(heroPost.data.pubDate)}
          preview={getExcerpt(heroPost.body)}
          image={heroPost.data.image}
        />
      )) || (
        <p class="text-center text-xl font-base">
          It appears there aren't any articles yet...
        </p>
      )
    }
    <div class="my-6 flex flex-col">
      <h2 class="text-3xl font-heading text-center mb-8">All Posts</h2>
      <div class="w-full flex flex-wrap justify-center gap-8">
        {
          recentPosts.map((post) => (
            <BlogPostCard
              url={`/posts/${post.id}/`}
              title={post.data.title}
              pubDate={formatDate(post.data.pubDate)}
              description={post.data.description}
              image={post.data.image}
              tags={post.data.tags}
            />
          ))
        }
      </div>
      <span class="mt-8 mx-auto">
        <NavLink target="/archive" title="See more." />
      </span>
    </div>
    <div
      class="my-12 p-4 bg-white border-black border-4
      shadow-[4px_4px_0px_rgba(0,0,0,1)] md:shadow-[8px_8px_0px_rgba(0,0,0,1)]
      text-center w-full md:w-2/3 mx-auto"
    >
      <h2 class="text-3xl font-bold mb-4 font-heading">Stay Updated!</h2>
      <p class="mb-4">
        Follow new posts with your favourite RSS reader.
      </p>
      <div
        class="mt-2 flex flex-col gap-2 items-center md:flex-row md:justify-center md:gap-4 w-full"
      >
        <RSSReaderLink
          target="https://www.inoreader.com/?add_feed="
          target_name="Inoreader"
        />
        <RSSReaderLink
          target="https://feedly.com/i/subscription/feed/"
          target_name="Feedly"
        />
        <RSS />
      </div>
    </div>
  </div>
</Layout>
