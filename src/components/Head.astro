---
import "../styles/global.css"; // Tailwind v4 entry (@import "tailwindcss" + @theme)

// Self-hosted fonts via @fontsource (replaces the old render-blocking Google Fonts CDN
// link). Each `wght.css` is subset-split by unicode-range, so English readers only fetch
// the Latin woff2 on demand. Italics are real (not browser-synthesised) for the serif and
// body faces, which both render <em> text.
import "@fontsource/bebas-neue/latin-400.css"; // display / headings (single weight)
import "@fontsource-variable/piazzolla/wght.css"; // subheadings (serif)
import "@fontsource-variable/piazzolla/wght-italic.css";
import "@fontsource-variable/ysabeau/wght.css"; // body copy
import "@fontsource-variable/ysabeau/wght-italic.css";

const { title, description, pubDate, author, image } = Astro.props;
const siteUrl = "https://justgood.games";

// Build the structured data as a real object here (frontmatter), then inject it with
// `set:html` below. Astro does NOT evaluate `{...}` expressions inside <script>/<style>
// raw-text elements, so the previous inline `{{...}}` shipped as literal source text and
// was inert. JSON.stringify also drops any `undefined` fields, so non-article pages (which
// only pass `title`) emit a clean object.
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  ...(image?.url && { image: siteUrl + image.url }),
  ...(author && { author: { "@type": "Person", name: author } }),
  ...(pubDate && {
    datePublished: pubDate instanceof Date ? pubDate.toISOString() : pubDate,
  }),
  publisher: {
    "@type": "Organization",
    name: "Just Good Games",
    logo: {
      "@type": "ImageObject",
      url: siteUrl + "/images/favicon.png",
    },
  },
};
---

<meta charset="utf-8" />
<link rel="icon" type="png" href="/images/favicon.png" />
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>

<!-- SEO Meta Tags -->
<meta name="description" content={description} />
<link rel="canonical" href={Astro.url} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="article" />
<meta property="og:url" content={siteUrl + Astro.url.pathname} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{image && <meta property="og:image" content={siteUrl + image.url} />}
{pubDate && (
  <meta
    property="article:published_time"
    content={pubDate instanceof Date ? pubDate.toISOString() : pubDate}
  />
)}
<meta property="article:author" content={author} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={siteUrl + Astro.url.pathname} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{image && <meta name="twitter:image" content={siteUrl + image.url} />}

<!-- Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
