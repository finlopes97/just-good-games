---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import BlogPostCard from "../../components/BlogPostCard.astro";
import Tag from "../../components/Tag.astro";
import { formatDate } from "../../utils/dateFormatter";
import { countTags } from "../../utils/tags";

export async function getStaticPaths() {
  const allPosts = await getCollection("posts");
  const tagCounts = countTags(allPosts);

  return tagCounts.map(({ tag }) => {
    const filteredPosts = allPosts.filter((post) =>
      post.data.tags.includes(tag)
    );
    return {
      params: { tag },
      props: { posts: filteredPosts, allTags: tagCounts },
    };
  });
}

const { tag } = Astro.params;
const { posts, allTags } = Astro.props;

const description = `${posts.length} ${
  posts.length === 1 ? "article" : "articles"
} tagged "${tag}" on Just Good Games — indie games worth your time.`;
---

<Layout title={`Posts tagged ${tag}`} description={description} pageType="collection">
  <div class="">
    <h1
      class="text-4xl md:text-5xl p-2 md:p-4 font-heading mb-8 transform -rotate-2 inline-block bg-foreground-500 text-background-100"
    >
      Posts tagged with <span class="text-body-300">{tag}</span>
    </h1>

    <div class="mb-12 mx-2 p-4 bg-background-100 border-4 border-foreground-500">
      <h2
        class="text-2xl font-heading mb-4 transform rotate-1 inline-block bg-body-300 p-2"
      >
        Popular Tags:
      </h2>
      <div class="flex flex-wrap items-center gap-1">
        {allTags.slice(0, 10).map((t) => <Tag name={t.tag} count={t.count} />)}
        {
          allTags.length > 10 && (
            <a
              href="/tags/"
              class="ml-2 font-body text-lg underline decoration-2 underline-offset-4 hover:text-accent-600"
            >
              View all tags
            </a>
          )
        }
      </div>
    </div>

    <div class="w-full flex flex-wrap justify-center gap-8">
      {
        posts.map((post) => (
          <BlogPostCard
            url={`/posts/${post.id}/`}
            title={post.data.title}
            pubDate={formatDate(post.data.pubDate)}
            description={post.data.description}
            image={post.data.image}
            tags={post.data.tags}
          />
        ))
      }
    </div>
  </div>
</Layout>
