---
import "../styles/global.css"; // Tailwind v4 entry (@import "tailwindcss" + @theme)

// Self-hosted fonts via @fontsource (replaces the old render-blocking Google Fonts CDN
// link). Each `wght.css` is subset-split by unicode-range, so English readers only fetch
// the Latin woff2 on demand. Italics are real (not browser-synthesised) for the serif and
// body faces, which both render <em> text.
import "@fontsource/bebas-neue/latin-400.css"; // display / headings (single weight)
import "@fontsource-variable/piazzolla/wght.css"; // subheadings (serif)
import "@fontsource-variable/piazzolla/wght-italic.css";
import "@fontsource-variable/ysabeau/wght.css"; // body copy
import "@fontsource-variable/ysabeau/wght-italic.css";

const { title, description, pubDate, author, image } = Astro.props;
const siteUrl = "https://justgood.games";
const siteName = "Just Good Games";
// Safety net only — every page should pass its own description.
const defaultDescription =
  "Just Good Games is a blog about lesser-known indie games: the niche ones that deserve more time in the spotlight.";

// A page is an article iff it has a publish date (only posts pass one).
const isArticle = Boolean(pubDate);
const isHome = Astro.url.pathname === "/";
const pageUrl = siteUrl + Astro.url.pathname;
const metaDescription = description ?? defaultDescription;
// <title> carries the site name for search results; og:title stays bare because the
// embed already shows og:site_name.
const documentTitle = isHome ? siteName : `${title} | ${siteName}`;
const ogTitle = isHome ? siteName : title;
const isoPubDate = pubDate instanceof Date ? pubDate.toISOString() : pubDate;

// Build the structured data as a real object here (frontmatter), then inject it with
// `set:html` below. Astro does NOT evaluate `{...}` expressions inside <script>/<style>
// raw-text elements. JSON.stringify drops any `undefined` fields.
const website = { "@type": "WebSite", name: siteName, url: siteUrl + "/" };
const structuredData = isArticle
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description: metaDescription,
      url: pageUrl,
      ...(image?.url && { image: siteUrl + image.url }),
      ...(author && { author: { "@type": "Person", name: author } }),
      datePublished: isoPubDate,
      publisher: {
        "@type": "Organization",
        name: siteName,
        logo: {
          "@type": "ImageObject",
          url: siteUrl + "/images/favicon.png",
        },
      },
    }
  : isHome
    ? { "@context": "https://schema.org", ...website, description: metaDescription }
    : {
        "@context": "https://schema.org",
        "@type": "WebPage",
        name: title,
        description: metaDescription,
        url: pageUrl,
        isPartOf: website,
      };
---

<meta charset="utf-8" />
<link rel="icon" type="image/png" href="/images/favicon.png" />
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />
<title>{documentTitle}</title>
<link rel="alternate" type="application/rss+xml" title={siteName} href={siteUrl + "/rss.xml"} />

<!-- SEO Meta Tags -->
<meta name="description" content={metaDescription} />
<link rel="canonical" href={Astro.url} />

<!-- Open Graph / Facebook -->
<meta property="og:site_name" content={siteName} />
<meta property="og:type" content={isArticle ? "article" : "website"} />
<meta property="og:url" content={pageUrl} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={metaDescription} />
{image && <meta property="og:image" content={siteUrl + image.url} />}
{isArticle && <meta property="article:published_time" content={isoPubDate} />}
{isArticle && author && <meta property="article:author" content={author} />}

<!-- Twitter -->
<!-- Large card only when there's an image to fill it; otherwise the compact card. -->
<meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
<meta name="twitter:url" content={pageUrl} />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={metaDescription} />
{image && <meta name="twitter:image" content={siteUrl + image.url} />}

<!-- Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
